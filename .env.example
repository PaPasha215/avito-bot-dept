APP_NAME=Avito AI Assistant
ENVIRONMENT=dev
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/app.db
POLLING_ENABLED=true
POLL_INTERVAL_SECONDS=10
RETENTION_DAYS=90

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
CLASSIFIER_CONFIDENCE_THRESHOLD=0.80
MAX_RECENT_MESSAGES_FOR_CLASSIFICATION=6
MAX_RECENT_MESSAGES_FOR_REPLY=10

AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=
AVITO_TOKEN_URL=https://api.avito.ru/token
AVITO_UPDATES_URL=https://api.avito.ru/messenger/v1/accounts/USER_ID/events
AVITO_CHAT_CONTEXT_URL_TEMPLATE=https://api.avito.ru/messenger/v1/accounts/{user_id}/chats/{chat_id}
AVITO_SEND_MESSAGE_URL_TEMPLATE=https://api.avito.ru/messenger/v1/accounts/{user_id}/chats/{chat_id}/messages
AVITO_POLL_LIMIT=50
AVITO_REQUEST_TIMEOUT_SECONDS=20

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_LEADS_CHAT_ID=
TELEGRAM_QA_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

REAL_ESTATE_PROMPT_VERSION=REAL_ESTATE_PROMPT_V1
