APP_NAME=Avito AI Assistant
ENVIRONMENT=dev
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/app.db
POLLING_ENABLED=true
POLL_INTERVAL_SECONDS=10
RETENTION_DAYS=90

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
CLASSIFIER_CONFIDENCE_THRESHOLD=0.80
MAX_RECENT_MESSAGES_FOR_CLASSIFICATION=6
MAX_RECENT_MESSAGES_FOR_REPLY=10
REPLY_DELAY_SECONDS=0
SELF_LEARNING_ENABLED=true
SELF_LEARNING_LOOKBACK_DAYS=7
SELF_LEARNING_INTERVAL_HOURS=24
SELF_LEARNING_MAX_SOURCE_CHATS=300
SELF_LEARNING_MAX_EXAMPLES_PER_RUN=500
SELF_LEARNING_EXAMPLES_PER_PROMPT=3
SELF_LEARNING_CANARY_PERCENT=20
SELF_LEARNING_ROLLBACK_WRONG_DOMAIN_THRESHOLD=1
SELF_LEARNING_PROMOTE_MIN_LEADS=3
STATS_REPORTING_ENABLED=false
STATS_REPORT_INTERVAL_HOURS=24
STATS_REPORT_LOOKBACK_DAYS=14
STATS_REPORT_LIMIT=60
STATS_REPORT_ITEM_DETAIL_LIMIT=20
STATS_REPORT_MIN_VIEWS_FOR_CONVERSION=30
STATS_REPORT_LOW_CONVERSION_THRESHOLD=3.5
STATS_REPORT_WEEKDAY=1
STATS_REPORT_HOUR=9
STATS_REPORT_MINUTE=0
STATS_REPORT_TIMEZONE=Asia/Yekaterinburg

AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=
AVITO_TOKEN_URL=https://api.avito.ru/token
AVITO_UPDATES_URL=https://api.avito.ru/messenger/v2/accounts/{user_id}/chats
AVITO_CHAT_CONTEXT_URL_TEMPLATE=https://api.avito.ru/messenger/v2/accounts/{user_id}/chats/{chat_id}
AVITO_SEND_MESSAGE_URL_TEMPLATE=https://api.avito.ru/messenger/v1/accounts/{user_id}/chats/{chat_id}/messages
AVITO_MESSAGES_URL_TEMPLATE=https://api.avito.ru/messenger/v3/accounts/{user_id}/chats/{chat_id}/messages/
AVITO_MESSAGES_FALLBACK_URL_TEMPLATE=https://api.avito.ru/messenger/v1/accounts/{user_id}/chats/{chat_id}/messages/
AVITO_POLL_LIMIT=50
AVITO_REQUEST_TIMEOUT_SECONDS=20

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_LEADS_CHAT_ID=
TELEGRAM_QA_CHAT_ID=
TELEGRAM_STATS_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

REAL_ESTATE_PROMPT_VERSION=REAL_ESTATE_PROMPT_V1
